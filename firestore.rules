rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function self(uid){return signed() && request.auth.uid == uid;}
  function me(){return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;}
  function active(){return signed() && request.auth.token.email_verified == true && me().status == 'active';}
  function owner(){return active() && me().role == 'owner';}
  function permission(scope){return active() && (me().role == 'owner' || (me().role == 'committee' && (me().termUntil == 0 || me().termUntil > request.time.toMillis()) && scope in me().permissions));}
  function finance(){return permission('finance');}
  function ownRead(){return finance() || (active() && resource.data.uid == request.auth.uid);}
  function openYear(d){return !exists(/databases/$(database)/documents/yearLocks/$(d[0:4])) || get(/databases/$(database)/documents/yearLocks/$(d[0:4])).data.closed == false;}
  function date(d){return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');}
  function month(m){return m is string && m.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');}
  function amount(n){return n is int && n>0 && n<=10000000;}
  function text(s,max){return s is string && s.size()<=max;}
  function member(d){return d.keys().hasAll(['name','email','type','status','discount','role','permissions','termUntil','createdAt','approvedBy']) && d.keys().hasOnly(['name','email','type','status','discount','role','permissions','termUntil','createdAt','approvedBy','updatedAt']) && text(d.name,80) && d.name.size()>0 && text(d.email,254) && d.type in ['full','adhoc'] && d.status in ['pending','active','suspended'] && d.discount is number && d.discount>=0 && d.discount<=100 && d.role in ['member','committee','owner'] && d.permissions is list && d.permissions.hasOnly(['finance','activities','stock']) && d.termUntil is number;}
  match /members/{uid}{
   allow get: if self(uid) || finance(); allow list: if finance();
   allow create: if self(uid) && member(request.resource.data) && request.resource.data.email==request.auth.token.email && request.resource.data.role=='member' && request.resource.data.status=='pending' && request.resource.data.type=='full' && request.resource.data.discount==0 && request.resource.data.permissions.size()==0 && request.resource.data.termUntil==0 && request.resource.data.approvedBy=='';
   allow update: if owner() && member(request.resource.data) && request.resource.data.email==resource.data.email && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.approvedBy==request.auth.uid && ((resource.data.role=='owner' && request.resource.data.role=='owner' && request.resource.data.status=='active') || (resource.data.role!='owner' && request.resource.data.role!='owner'));
  }
  function validPlan(d){return month(d.month) && d.mode in ['monthly','attendance','exempt'] && d.factor is number && d.factor>=0 && d.factor<=1 && text(d.reason,300) && d.reason.size()>0;}
  match /plans/{key}{allow read:if ownRead();allow create,update:if finance() && request.resource.data.keys().hasOnly(['uid','month','mode','factor','reason','approvedBy','updatedAt']) && validPlan(request.resource.data) && key==request.resource.data.month+'_'+request.resource.data.uid && request.resource.data.approvedBy==request.auth.uid && openYear(request.resource.data.month);}
  match /requests/{key}{
   allow read:if ownRead();allow create:if active() && request.resource.data.uid==request.auth.uid && request.resource.data.keys().hasOnly(['uid','month','mode','factor','reason','status','createdAt']) && validPlan(request.resource.data) && request.resource.data.status=='pending' && openYear(request.resource.data.month);
   allow update:if finance() && resource.data.status=='pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reason','reviewedBy','reviewedAt']) && request.resource.data.status in ['approved','rejected'] && request.resource.data.reviewedBy==request.auth.uid && openYear(resource.data.month);
  }
  match /periods/{monthId}{allow read:if active();allow create,update:if finance() && month(monthId) && openYear(monthId) && request.resource.data.keys().hasOnly(['monthly','attendance','closed','reason','approvedBy','updatedAt']) && request.resource.data.monthly is int && request.resource.data.monthly>=0 && request.resource.data.monthly<=10000000 && request.resource.data.attendance is int && request.resource.data.attendance>=0 && request.resource.data.attendance<=10000000 && request.resource.data.closed is bool && text(request.resource.data.reason,300) && request.resource.data.approvedBy==request.auth.uid;}
  match /charges/{key}{
   allow read:if ownRead();allow create:if finance() && openYear(request.resource.data.date) && request.resource.data.keys().hasOnly(['uid','label','month','date','amount','paid','factor','kind','createdAt','createdBy','guestName']) && date(request.resource.data.date) && month(request.resource.data.month) && request.resource.data.amount is int && request.resource.data.amount>=0 && request.resource.data.amount<=10000000 && request.resource.data.kind in ['monthly','adhoc'] && text(request.resource.data.label,250) && request.resource.data.createdBy==request.auth.uid;
   allow update:if finance() && openYear(resource.data.date) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount','correctionReason','correctedBy','correctedAt']) && request.resource.data.amount is int && request.resource.data.amount>=0 && request.resource.data.amount<=10000000 && text(request.resource.data.correctionReason,300) && request.resource.data.correctedBy==request.auth.uid;
  }
  function payment(d){return d.uid is string && d.bucket in ['monthly','attendance'] && amount(d.amount) && date(d.date) && text(d.reference,100) && d.reference.size()>0 && d.method in ['Bank transfer','Cash'] && text(d.guestName,80) && text(d.proofId,100);}
  function reversal(){return owner() && openYear(resource.data.date) && !('voidedAt' in resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voidedAt','voidedBy','voidReason']) && request.resource.data.voidedBy==request.auth.uid && request.resource.data.voidedAt is number && text(request.resource.data.voidReason,300) && request.resource.data.voidReason.size()>0;}
  match /payments/{key}{allow read:if ownRead();allow create:if finance() && openYear(request.resource.data.date) && request.resource.data.keys().hasOnly(['uid','bucket','amount','date','reference','method','guestName','proofId','createdAt','createdBy']) && payment(request.resource.data) && request.resource.data.createdBy==request.auth.uid;allow update:if reversal();}
  match /submissions/{key}{
   allow read:if ownRead();allow create:if active() && openYear(request.resource.data.date) && request.resource.data.uid==request.auth.uid && request.resource.data.keys().hasOnly(['uid','bucket','amount','date','reference','method','guestName','proofId','status','createdAt']) && payment(request.resource.data) && request.resource.data.status=='pending' && (request.resource.data.proofId=='' || request.resource.data.proofId==key);
   allow update:if finance() && resource.data.status=='pending' && openYear(resource.data.date) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reason','reviewedBy','reviewedAt']) && request.resource.data.status in ['approved','rejected'] && request.resource.data.reviewedBy==request.auth.uid && (request.resource.data.status=='rejected' || existsAfter(/databases/$(database)/documents/payments/$(('approved_'+key))));
  }
  match /proofs/{key}{
   allow read:if ownRead();
   allow create:if active() && request.resource.data.keys().hasOnly(['uid','image','createdAt','submissionId','paymentId']) && text(request.resource.data.image,250000) && request.resource.data.image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$') && ((request.resource.data.uid==request.auth.uid && request.resource.data.submissionId==key && getAfter(/databases/$(database)/documents/submissions/$(key)).data.uid==request.auth.uid && getAfter(/databases/$(database)/documents/submissions/$(key)).data.proofId==key) || (finance() && request.resource.data.paymentId==key && getAfter(/databases/$(database)/documents/payments/$(key)).data.uid==request.resource.data.uid && getAfter(/databases/$(database)/documents/payments/$(key)).data.proofId==key));
  }
  match /expenses/{key}{allow read:if finance();allow create:if finance() && openYear(request.resource.data.date) && request.resource.data.keys().hasOnly(['category','description','amount','date','reference','createdAt','createdBy']) && amount(request.resource.data.amount) && date(request.resource.data.date) && request.resource.data.category in ['Courts','Shuttlecocks','Tournament','Friendly match','Equipment','Other'] && text(request.resource.data.description,200) && text(request.resource.data.reference,100) && request.resource.data.createdBy==request.auth.uid;allow update:if reversal();}
  match /summaries/{key}{allow read:if finance();allow create,update:if finance() && month(key) && openYear(key) && request.resource.data.keys().hasOnly(['billed','received','expenses','opening']) && request.resource.data.billed is int && request.resource.data.received is int && request.resource.data.expenses is int;}
  match /openings/{key}{allow read:if ownRead();allow create:if finance() && request.resource.data.keys().hasOnly(['uid','year','amount','reason','createdBy','createdAt']) && request.resource.data.year is int && request.resource.data.year>=2000 && request.resource.data.year<=2100 && key==string(request.resource.data.year)+'_'+request.resource.data.uid && openYear(string(request.resource.data.year)) && request.resource.data.amount is int && text(request.resource.data.reason,300) && request.resource.data.createdBy==request.auth.uid;}
  match /yearOpenings/{year}{allow read:if finance();allow create:if finance() && year.matches('^[0-9]{4}$') && openYear(year) && request.resource.data.keys().hasOnly(['amount','reason','createdBy','createdAt']) && request.resource.data.amount is int && text(request.resource.data.reason,300) && request.resource.data.createdBy==request.auth.uid;}
  match /yearLocks/{year}{allow read:if active();allow create,update:if owner() && year.matches('^[0-9]{4}$') && request.resource.data.keys().hasOnly(['closed','updatedAt','updatedBy']) && request.resource.data.closed is bool && request.resource.data.updatedBy==request.auth.uid;}
  match /publications/{key}{allow read:if active();allow create,update:if finance() && request.resource.data.keys().hasOnly(['year','month','rows','attendance','totals','expenseRows','income','expenses','net','publishedAt','publishedBy']) && request.resource.data.year is int && request.resource.data.month is int && request.resource.data.month>=1 && request.resource.data.month<=12 && request.resource.data.rows is list && request.resource.data.rows.size()<=200 && request.resource.data.attendance is list && request.resource.data.totals is list && request.resource.data.expenseRows is list && request.resource.data.income is int && request.resource.data.expenses is int && request.resource.data.net is int && request.resource.data.publishedBy==request.auth.uid;}
  function sessionOpen(id){let a=get(/databases/$(database)/documents/activities/$(id)).data;return a.status in ['Planned','Scheduled'] && (!exists(/databases/$(database)/documents/periods/$(a.date[0:7])) || !get(/databases/$(database)/documents/periods/$(a.date[0:7])).data.closed);}
  function activity(d){return d.keys().hasOnly(['title','kind','date','time','end','venue','courts','capacity','cost','notes','results','status','updatedAt','createdBy']) && text(d.title,100) && d.title.size()>0 && d.kind in ['Club session','Internal tournament','Friendly match'] && date(d.date) && text(d.time,5) && text(d.end,5) && text(d.venue,160) && text(d.courts,60) && d.capacity is int && d.capacity>0 && d.capacity<=200 && d.cost is int && d.cost>=0 && text(d.notes,2000) && text(d.results,4000) && d.status in ['Planned','Scheduled','Completed','Cancelled'] && d.createdBy==request.auth.uid;}
  match /activities/{key}{allow read:if active();allow create,update:if permission('activities') && activity(request.resource.data) && (request.resource.data.status=='Cancelled' || !exists(/databases/$(database)/documents/periods/$(request.resource.data.date[0:7])) || !get(/databases/$(database)/documents/periods/$(request.resource.data.date[0:7])).data.closed);}
  match /rsvps/{key}{allow read:if ownRead();allow create,update:if active() && request.resource.data.keys().hasOnly(['uid','activityId','status','updatedAt']) && request.resource.data.uid==request.auth.uid && key==request.resource.data.activityId+'_'+request.auth.uid && request.resource.data.status in ['going','not-going'] && sessionOpen(request.resource.data.activityId);}
  match /attendance/{key}{allow read:if ownRead();allow create:if finance() && openYear(request.resource.data.date) && request.resource.data.keys().hasOnly(['uid','guestName','activityId','date','amount','createdBy','createdAt']) && date(request.resource.data.date) && text(request.resource.data.guestName,80) && request.resource.data.amount is int && request.resource.data.amount>=0 && request.resource.data.createdBy==request.auth.uid;}
  match /stock/{key}{allow read:if permission('stock');allow create:if permission('stock') && request.resource.data.keys().hasOnly(['kind','date','quantity','notes','createdBy','createdAt']) && request.resource.data.kind in ['Opening stock','Purchase','Used','Adjustment in','Adjustment out'] && date(request.resource.data.date) && request.resource.data.quantity is int && request.resource.data.quantity!=0 && request.resource.data.quantity>=-10000 && request.resource.data.quantity<=10000 && text(request.resource.data.notes,300) && request.resource.data.createdBy==request.auth.uid;}
  match /settings/stockControl{allow read:if permission('stock');allow create,update:if permission('stock') && request.resource.data.keys().hasOnly(['quantity','updatedAt']) && request.resource.data.quantity is int && request.resource.data.quantity>=0;}
  match /settings/club{allow read:if active();allow create,update:if owner() && request.resource.data.keys().hasOnly(['name','notice','bankName','accountName','accountNumber','qrData','stockThreshold']) && text(request.resource.data.notice,1000) && text(request.resource.data.bankName,100) && text(request.resource.data.accountName,100) && text(request.resource.data.accountNumber,40) && text(request.resource.data.qrData,250000) && request.resource.data.stockThreshold is int && request.resource.data.stockThreshold>=0;}
  match /audit/{key}{allow read:if owner();allow create:if active() && request.resource.data.keys().hasOnly(['id','actor','action','at']) && request.resource.data.actor==request.auth.uid && text(request.resource.data.action,1000) && request.resource.data.at is number;}
  match /{doc=**}{allow read,write:if false;}
 }
}
